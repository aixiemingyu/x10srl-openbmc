/dts-v1/;

#include "aspeed-g4.dtsi"
#include <dt-bindings/gpio/aspeed-gpio.h>

/ {
    model = "Supermicro X10SRL-F BMC";
    compatible = "supermicro,x10srl-bmc", "aspeed,ast2400";

    chosen {
        stdout-path = &uart5;
        bootargs = "console=ttyS4,115200 earlyprintk";
    };

    memory@40000000 {
        // Conservative 256MB - actual hardware may have 512MB
        // Verify with actual hardware before increasing
        reg = <0x40000000 0x10000000>;
    };

    reserved-memory {
        #address-cells = <1>;
        #size-cells = <1>;
        ranges;

        vga_memory: framebuffer@4f000000 {
            no-map;
            reg = <0x4f000000 0x01000000>; // 16MB for VGA
        };
    };

    leds {
        compatible = "gpio-leds";

        // LED GPIO assignments are PLACEHOLDERS
        // Need verification from actual hardware or GPL source analysis
        led-identify {
            label = "identify";
            gpios = <&gpio ASPEED_GPIO(A, 0) GPIO_ACTIVE_LOW>;
        };

        led-status {
            label = "status";
            gpios = <&gpio ASPEED_GPIO(A, 1) GPIO_ACTIVE_LOW>;
        };
    };

    iio-hwmon {
        compatible = "iio-hwmon";
        // ADC channels enabled - specific sensor mapping needs verification
        io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>,
                      <&adc 4>, <&adc 5>, <&adc 6>, <&adc 7>;
    };

    iio-hwmon-battery {
        compatible = "iio-hwmon";
        io-channels = <&adc 8>;
    };
};

&fmc {
    status = "okay";
    flash@0 {
        status = "okay";
        m25p,fast-read;
        label = "bmc";
        spi-max-frequency = <50000000>;
#include "openbmc-flash-layout.dtsi"
    };
};

&spi {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_spi1_default>;

    flash@0 {
        status = "okay";
        m25p,fast-read;
        label = "pnor";
        spi-max-frequency = <100000000>;
    };
};

&uart5 {
    status = "okay";
};

&mac0 {
    status = "okay";
    use-ncsi;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_rmii1_default>;
};

&mac1 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_rgmii2_default>;
};

// I2C bus assignments are GENERIC
// Actual sensor addresses and devices need verification
&i2c0 {
    status = "okay";
    // Typically FRU EEPROM location
    eeprom@50 {
        compatible = "atmel,24c256";
        reg = <0x50>;
        pagesize = <64>;
    };
};

&i2c1 {
    status = "okay";
};

&i2c2 {
    status = "okay";
};

&i2c3 {
    status = "okay";
};

&i2c4 {
    status = "okay";
};

&i2c5 {
    status = "okay";
};

&i2c6 {
    status = "okay";
};

&i2c7 {
    status = "okay";
    // Temperature sensor placeholders - addresses need verification
    lm75@48 {
        compatible = "national,lm75";
        reg = <0x48>;
    };

    lm75@49 {
        compatible = "national,lm75";
        reg = <0x49>;
    };
};

&i2c8 {
    status = "okay";
};

&i2c9 {
    status = "okay";
};

&i2c10 {
    status = "okay";
};

&i2c11 {
    status = "okay";
};

&i2c12 {
    status = "okay";
};

&i2c13 {
    status = "okay";
};

&gpio {
    status = "okay";
    // GPIO line names are PLACEHOLDERS
    // Actual GPIO usage needs to be extracted from vendor GPL source
    gpio-line-names =
    /*A0-A7*/   "","","","","","","","",
    /*B0-B7*/   "","","","","","","","",
    /*C0-C7*/   "","","","","","","","",
    /*D0-D7*/   "","","","","","","","",
    /*E0-E7*/   "","","","","","","","",
    /*F0-F7*/   "","","","","","","","",
    /*G0-G7*/   "","","","","","","","",
    /*H0-H7*/   "","","","","","","","",
    /*I0-I7*/   "","","","","","","","",
    /*J0-J7*/   "","","","","","","","",
    /*K0-K7*/   "","","","","","","","",
    /*L0-L7*/   "","","","","","","","",
    /*M0-M7*/   "","","","","","","","",
    /*N0-N7*/   "","","","","","","","",
    /*O0-O7*/   "","","","","","","","",
    /*P0-P7*/   "","","","","","","","",
    /*Q0-Q7*/   "","","","","","","","",
    /*R0-R7*/   "","","","","","","","",
    /*S0-S7*/   "","","","","","","","",
    /*T0-T7*/   "","","","","","","","",
    /*U0-U7*/   "","","","","","","","",
    /*V0-V7*/   "","","","","","","","",
    /*W0-W7*/   "","","","","","","","",
    /*X0-X7*/   "","","","","","","","",
    /*Y0-Y7*/   "","","","","","","","",
    /*Z0-Z7*/   "","","","","","","","",
    /*AA0-AA7*/ "","","","","","","","",
    /*AB0-AB7*/ "","","","","","","","";
};

&adc {
    status = "okay";
};

&pwm_tacho {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_pwm0_default &pinctrl_pwm1_default
                 &pinctrl_pwm2_default &pinctrl_pwm3_default
                 &pinctrl_pwm4_default &pinctrl_pwm5_default
                 &pinctrl_pwm6_default &pinctrl_pwm7_default>;

    // Fan channel assignments need verification
    fan@0 {
        reg = <0x00>;
        aspeed,fan-tach-ch = /bits/ 8 <0x00>;
    };

    fan@1 {
        reg = <0x01>;
        aspeed,fan-tach-ch = /bits/ 8 <0x01>;
    };

    fan@2 {
        reg = <0x02>;
        aspeed,fan-tach-ch = /bits/ 8 <0x02>;
    };

    fan@3 {
        reg = <0x03>;
        aspeed,fan-tach-ch = /bits/ 8 <0x03>;
    };

    fan@4 {
        reg = <0x04>;
        aspeed,fan-tach-ch = /bits/ 8 <0x04>;
    };
};

&kcs3 {
    status = "okay";
    aspeed,lpc-io-reg = <0xca2>;
};

&lpc_ctrl {
    status = "okay";
};

&lpc_snoop {
    status = "okay";
    snoop-ports = <0x80>;
};
